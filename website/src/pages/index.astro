</style>

<script>
	// -------------------------------------------------------------
	// HTML2CANVAS Dynamic Script Injector
	// -------------------------------------------------------------
	declare global {
		interface Window {
			html2canvas: any;
			currentWebCrop: string | null;
			currentWebCropText: string | null;
			ocrCaptureMode: boolean;
		}
	}

	window.ocrCaptureMode = false;

	function loadHtml2Canvas(): Promise<any> {
		return new Promise((resolve, reject) => {
			if (window.html2canvas) {
				resolve(window.html2canvas);
				return;
			}
			const script = document.createElement('script');
			script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
			script.onload = () => resolve(window.html2canvas);
			script.onerror = (err) => reject(err);
			document.head.appendChild(script);
		});
	}

	// -------------------------------------------------------------
	// Live Web Crop Selector & Dragging Logic
	// -------------------------------------------------------------
	let isDragging = false;
	let startX = 0;
	let startY = 0;
	
	const cropOverlay = document.getElementById('web-crop-overlay') as HTMLElement;
	const cropBox = document.getElementById('crop-selection-box') as HTMLElement;
	const cropSize = document.getElementById('crop-size-badge') as HTMLElement;

	function extractTextFromRect(left: number, top: number, width: number, height: number): string {
		const elements = document.querySelectorAll('p, h1, h2, h3, span, code, a');
		const foundText: string[] = [];

		elements.forEach((el) => {
			const rect = el.getBoundingClientRect();
			
			// Detect box boundary intersection
			const overlapX = Math.max(0, Math.min(rect.right, left + width) - Math.max(rect.left, left));
			const overlapY = Math.max(0, Math.min(rect.bottom, top + height) - Math.max(rect.top, top));

			if (overlapX > 0 && overlapY > 0 && el.textContent) {
				// Leaf text nodes only
				if (el.children.length === 0) {
					foundText.push(el.textContent.trim());
				}
			}
		});

		return foundText.filter(t => t.length > 2).join(' ') || '[No text detected in selected region]';
	}

	function cancelCrop() {
		if (cropOverlay && cropBox) {
			cropOverlay.classList.remove('active');
			cropBox.style.display = 'none';
			isDragging = false;
			window.ocrCaptureMode = false;
		}
	}

	function setupWebCrop() {
		const tryLiveBtn = document.getElementById('try-live-capture-btn');
		if (!tryLiveBtn || !cropOverlay || !cropBox || !cropSize) return;

		// Pre-load script on button click
		tryLiveBtn.addEventListener('click', (e) => {
			e.preventDefault();
			loadHtml2Canvas().catch(console.error);
			cropOverlay.classList.add('active');
		});

		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && cropOverlay.classList.contains('active')) {
				cancelCrop();
			}
		});

		cropOverlay.addEventListener('mousedown', (e) => {
			isDragging = true;
			startX = e.clientX;
			startY = e.clientY;

			cropBox.style.left = `${startX}px`;
			cropBox.style.top = `${startY}px`;
			cropBox.style.width = '0px';
			cropBox.style.height = '0px';
			cropBox.style.display = 'block';
			cropSize.textContent = '0 × 0';
		});

		cropOverlay.addEventListener('mousemove', (e) => {
			if (!isDragging) return;

			const currentX = e.clientX;
			const currentY = e.clientY;

			const w = Math.abs(currentX - startX);
			const h = Math.abs(currentY - startY);
			const l = Math.min(currentX, startX);
			const t = Math.min(currentY, startY);

			cropBox.style.left = `${l}px`;
			cropBox.style.top = `${t}px`;
			cropBox.style.width = `${w}px`;
			cropBox.style.height = `${h}px`;
			cropSize.textContent = `${w} × ${h}`;
		});

		cropOverlay.addEventListener('mouseup', async (e) => {
			if (!isDragging) return;
			isDragging = false;

			const currentX = e.clientX;
			const currentY = e.clientY;
			const w = Math.abs(currentX - startX);
			const h = Math.abs(currentY - startY);
			const l = Math.min(currentX, startX);
			const t = Math.min(currentY, startY);

			if (w > 20 && h > 20) {
				// Hide box for clean render
				cropBox.style.display = 'none';
				cropOverlay.classList.remove('active');

				// Intersect DOM elements to extract text
				const extractedText = extractTextFromRect(l, t, w, h);
				window.currentWebCropText = extractedText;

				try {
					const h2c = await loadHtml2Canvas();
					const canvas = await h2c(document.body, {
						x: l + window.scrollX,
						y: t + window.scrollY,
						width: w,
						height: h,
						useCORS: true,
						logging: false,
						backgroundColor: '#08090a'
					});

					const imgUrl = canvas.toDataURL('image/png');
					window.currentWebCrop = imgUrl;

					// Sync to floating thumbnail
					const previewImg = document.querySelector('.thumbnail-preview-img');
					if (previewImg) {
						previewImg.innerHTML = `<img src="${imgUrl}" alt="Captured Area" style="width: 100%; height: 100%; object-fit: cover;" />`;
					}

					// If OCR specific hotkey mode: Open Studio modal directly with OCR triggered!
					if (window.ocrCaptureMode) {
						window.ocrCaptureMode = false;
						setTimeout(() => {
							openMarkupStudio();
							setTimeout(() => {
								if (modalOcrTriggerBtn) modalOcrTriggerBtn.click();
							}, 300);
						}, 500);
					} else {
						// Show desktop thumbnail preview
						const desktopThumbnail = document.getElementById('desktop-thumbnail');
						if (desktopThumbnail) {
							desktopThumbnail.classList.add('show');
							triggerThumbnailDismissTimer();
						}
					}

				} catch (err) {
					console.error('Screenshot rendering failed:', err);
				}
			} else {
				cancelCrop();
			}
		});
	}

	// -------------------------------------------------------------
	// Fullscreen Viewport Capture Engine
	// -------------------------------------------------------------
	async function triggerFullscreenCapture() {
		try {
			const h2c = await loadHtml2Canvas();
			const canvas = await h2c(document.body, {
				x: window.scrollX,
				y: window.scrollY,
				width: window.innerWidth,
				height: window.innerHeight,
				useCORS: true,
				logging: false,
				backgroundColor: '#08090a'
			});

			const imgUrl = canvas.toDataURL('image/png');
			window.currentWebCrop = imgUrl;
			
			// Intersect all text visible in the viewport
			window.currentWebCropText = extractTextFromRect(window.scrollX, window.scrollY, window.innerWidth, window.innerHeight);

			// Sync to floating thumbnail
			const previewImg = document.querySelector('.thumbnail-preview-img');
			if (previewImg) {
				previewImg.innerHTML = `<img src="${imgUrl}" alt="Full Viewport" style="width: 100%; height: 100%; object-fit: cover;" />`;
			}

			// Show desktop thumbnail preview
			const desktopThumbnail = document.getElementById('desktop-thumbnail');
			if (desktopThumbnail) {
				desktopThumbnail.classList.add('show');
				triggerThumbnailDismissTimer();
			}
		} catch (err) {
			console.error('Fullscreen capture failed:', err);
		}
	}

	// -------------------------------------------------------------
	// Global Keyboard Hotkey Observers
	// -------------------------------------------------------------
	window.addEventListener('keydown', (e) => {
		// Ignore shortcuts when editing text inputs
		if (document.activeElement?.tagName === 'INPUT' || document.activeElement?.tagName === 'TEXTAREA') {
			return;
		}

		const key = e.key.toLowerCase();

		if (key === 'c') {
			e.preventDefault();
			loadHtml2Canvas().catch(console.error);
			cropOverlay.classList.add('active');
		} 
		else if (key === 'f') {
			e.preventDefault();
			loadHtml2Canvas().then(triggerFullscreenCapture).catch(console.error);
		} 
		else if (key === 'o') {
			e.preventDefault();
			window.ocrCaptureMode = true;
			loadHtml2Canvas().catch(console.error);
			cropOverlay.classList.add('active');
		}
	});

	// -------------------------------------------------------------
	// macOS Menu Bar Actions & Live Clock
	// -------------------------------------------------------------
	function updateMenubarClock() {
		const clockEl = document.getElementById('menubar-clock');
		if (!clockEl) return;
		const now = new Date();

		const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
		const day = days[now.getDay()];
		let hr = now.getHours();
		const min = String(now.getMinutes()).padStart(2, '0');
		const ampm = hr >= 12 ? 'PM' : 'AM';
		hr = hr % 12;
		hr = hr ? hr : 12; // 0 hour is 12

		clockEl.textContent = `${day} ${hr}:${min} ${ampm}`;
	}
	setInterval(updateMenubarClock, 1000);
	updateMenubarClock();

	// Menu Bar Dropdown Toggles
	const trayIconWrapper = document.getElementById('tray-icon-wrapper');
	if (trayIconWrapper) {
		trayIconWrapper.addEventListener('click', (e) => {
			e.stopPropagation();
			trayIconWrapper.classList.toggle('active');
		});

		document.addEventListener('click', () => {
			trayIconWrapper.classList.remove('active');
		});
	}

	// Dropdown item click binds
	const trayActCrop = document.getElementById('tray-act-crop');
	const trayActFull = document.getElementById('tray-act-full');
	const trayActOcr = document.getElementById('tray-act-ocr');
	const trayActStudio = document.getElementById('tray-act-studio');

	if (trayActCrop) {
		trayActCrop.addEventListener('click', () => {
			loadHtml2Canvas().catch(console.error);
			cropOverlay.classList.add('active');
		});
	}

	if (trayActFull) {
		trayActFull.addEventListener('click', () => {
			loadHtml2Canvas().then(triggerFullscreenCapture).catch(console.error);
		});
	}

	if (trayActOcr) {
		trayActOcr.addEventListener('click', () => {
			window.ocrCaptureMode = true;
			loadHtml2Canvas().catch(console.error);
			cropOverlay.classList.add('active');
		});
	}

	if (trayActStudio) {
		trayActStudio.addEventListener('click', () => {
			openMarkupStudio();
		});
	}

	// -------------------------------------------------------------
	// Floating Desktop Screenshot Preview Thumbnail
	// -------------------------------------------------------------
	const captureWindow = document.getElementById('hero-capture-window');
	const desktopThumbnail = document.getElementById('desktop-thumbnail');
	const thumbnailClose = document.getElementById('thumbnail-close');
	const thumbnailPreviewTrigger = document.getElementById('thumbnail-preview-trigger');
	
	// Action buttons inside the floating thumbnail
	const thumbActPolish = document.getElementById('thumb-act-polish');
	const thumbActCopy = document.getElementById('thumb-act-copy');
	const thumbnailToast = document.getElementById('thumbnail-toast');

	// Modal Elements
	const beautifyModal = document.getElementById('beautify-modal') as HTMLElement;
	const modalCloseDot = document.getElementById('modal-close-dot') as HTMLElement;
	const modalBeautifyImg = document.getElementById('modal-beautify-img') as HTMLImageElement;
	const modalBeautifyCanvas = document.getElementById('modal-beautify-canvas') as HTMLElement;
	const modalPaddingSlider = document.getElementById('modal-padding-slider') as HTMLInputElement;
	const modalShadowToggle = document.getElementById('modal-shadow-toggle') as HTMLInputElement;
	const modalDownloadBtn = document.getElementById('modal-download-btn') as HTMLElement;
	const modalGradientPickers = document.getElementById('modal-gradient-pickers');
	const modalWindowTitle = document.getElementById('modal-window-title');

	// OCR Elements inside Modal
	const modalOcrTriggerBtn = document.getElementById('modal-ocr-trigger-btn') as HTMLButtonElement;
	const modalOcrStatus = document.getElementById('modal-ocr-status') as HTMLElement;
	const modalOcrTextbox = document.getElementById('modal-ocr-textbox') as HTMLTextAreaElement;
	const modalOcrCopyBtn = document.getElementById('modal-ocr-copy-btn') as HTMLElement;

	// Annotation Canvas Elements inside Modal
	const annotationCanvas = document.getElementById('annotation-canvas') as HTMLCanvasElement;
	const annoCtx = annotationCanvas ? annotationCanvas.getContext('2d') : null;

	let dismissTimeout: number;

	function triggerThumbnailDismissTimer() {
		clearTimeout(dismissTimeout);
		dismissTimeout = setTimeout(() => {
			if (desktopThumbnail) desktopThumbnail.classList.remove('show');
		}, 8000) as unknown as number; // Auto-dismiss after 8 seconds (matching macOS)
	}

	if (captureWindow && desktopThumbnail) {
		captureWindow.addEventListener('click', (e) => {
			if (e.target instanceof Element && e.target.closest('.window-dots')) return;

			// Reset saved crop
			window.currentWebCrop = null;
			window.currentWebCropText = null;

			// Clear thumbnail image to default
			const previewImg = document.querySelector('.thumbnail-preview-img');
			if (previewImg) {
				previewImg.innerHTML = `<div class="mini-preview-gradient"></div><div class="mini-preview-lines"><span></span><span></span><span></span></div>`;
			}

			setTimeout(() => {
				desktopThumbnail.classList.add('show');
				triggerThumbnailDismissTimer();
			}, 150);
		});
	}

	// Close thumbnail manually
	if (thumbnailClose && desktopThumbnail) {
		thumbnailClose.addEventListener('click', (e) => {
			e.stopPropagation();
			desktopThumbnail.classList.remove('show');
			clearTimeout(dismissTimeout);
		});
	}

	// Click thumbnail itself to open Studio
	if (thumbnailPreviewTrigger && desktopThumbnail) {
		thumbnailPreviewTrigger.addEventListener('click', (e) => {
			e.stopPropagation();
			desktopThumbnail.classList.remove('show');
			openMarkupStudio();
		});
	}

	// Quick Action: Studio (Polish/Annotate)
	if (thumbActPolish && desktopThumbnail) {
		thumbActPolish.addEventListener('click', (e) => {
			e.stopPropagation();
			desktopThumbnail.classList.remove('show');
			openMarkupStudio();
		});
	}

	// Open unified Studio overlay
	async function openMarkupStudio() {
		if (!beautifyModal || !modalBeautifyImg) return;

		let targetSrc = window.currentWebCrop;
		
		// If no custom crop, use placeholder browser markup
		if (!targetSrc) {
			targetSrc = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="240" viewBox="0 0 400 240"><rect width="400" height="240" fill="%231a1a1c"/><rect x="20" y="20" width="360" height="30" rx="4" fill="%232c2c2e"/><circle cx="40" cy="35" r="5" fill="%23ff5f56"/><circle cx="55" cy="35" r="5" fill="%23ffbd2e"/><circle cx="70" cy="35" r="5" fill="%2327c93f"/><text x="140" y="140" fill="rgba(255,255,255,0.4)" font-family="sans-serif" font-size="16">Take a Custom Crop to Edit</text></svg>';
			window.currentWebCropText = "Take a Custom Crop to Edit";
		}

		modalBeautifyImg.src = targetSrc;
		
		// Setup window dynamic title based on time
		if (modalWindowTitle) {
			const now = new Date();
			const timestamp = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}_${String(now.getHours()).padStart(2,'0')}${String(now.getMinutes()).padStart(2,'0')}`;
			modalWindowTitle.textContent = `aeroshot_capture_${timestamp}.png`;
		}

		// Reset OCR textbox inside modal
		if (modalOcrTextbox && modalOcrStatus) {
			modalOcrTextbox.value = '';
			modalOcrStatus.textContent = 'Ready';
			modalOcrStatus.classList.remove('active');
		}

		beautifyModal.classList.add('active');

		// Wait for image loading to resize drawing canvas overlay
		modalBeautifyImg.onload = () => {
			initAnnotationDrawing();
		};

		// Fallback if cached/loaded
		if (modalBeautifyImg.complete) {
			initAnnotationDrawing();
		}
	}

	// Close modal via traffic light red close dot
	if (modalCloseDot && beautifyModal) {
		modalCloseDot.addEventListener('click', () => {
			beautifyModal.classList.remove('active');
		});
		// Close on backdrop click
		beautifyModal.addEventListener('click', (e) => {
			if (e.target === beautifyModal) beautifyModal.classList.remove('active');
		});
	}

	// -------------------------------------------------------------
	// HTML5 Canvas Annotation Drawing Tools
	// -------------------------------------------------------------
	let currentTool = 'pen'; // 'pen', 'arrow', 'rect', 'redact'
	let drawColor = '#ff453a'; // red default
	let drawingHistory: ImageData[] = [];
	let isDrawingOnCanvas = false;
	let dragStartX = 0;
	let dragStartY = 0;

	function initAnnotationDrawing() {
		if (!annotationCanvas || !modalBeautifyImg || !annoCtx) return;

		// Set physical canvas attributes to match display size
		annotationCanvas.width = modalBeautifyImg.clientWidth;
		annotationCanvas.height = modalBeautifyImg.clientHeight;
		
		// Clear history
		drawingHistory = [];
		annoCtx.clearRect(0, 0, annotationCanvas.width, annotationCanvas.height);

		// Remove old listeners to avoid multiple attachments
		const newCanvas = annotationCanvas.cloneNode(true) as HTMLCanvasElement;
		annotationCanvas.parentNode?.replaceChild(newCanvas, annotationCanvas);
		
		// Re-fetch references
		const freshCanvas = document.getElementById('annotation-canvas') as HTMLCanvasElement;
		const freshCtx = freshCanvas.getContext('2d');
		if (!freshCtx) return;

		function getMouseCoords(e: MouseEvent) {
			const rect = freshCanvas.getBoundingClientRect();
			return {
				x: e.clientX - rect.left,
				y: e.clientY - rect.top
			};
		}

		function saveState() {
			drawingHistory.push(freshCtx.getImageData(0, 0, freshCanvas.width, freshCanvas.height));
			if (drawingHistory.length > 20) drawingHistory.shift();
		}

		freshCanvas.addEventListener('mousedown', (e) => {
			isDrawingOnCanvas = true;
			const coords = getMouseCoords(e);
			dragStartX = coords.x;
			dragStartY = coords.y;

			saveState();

			if (currentTool === 'pen') {
				freshCtx.beginPath();
				freshCtx.moveTo(dragStartX, dragStartY);
				freshCtx.strokeStyle = drawColor;
				freshCtx.lineWidth = 3;
				freshCtx.lineCap = 'round';
				freshCtx.lineJoin = 'round';
			}
		});

		freshCanvas.addEventListener('mousemove', (e) => {
			if (!isDrawingOnCanvas) return;
			const coords = getMouseCoords(e);

			if (currentTool === 'pen') {
				freshCtx.lineTo(coords.x, coords.y);
				freshCtx.stroke();
			} else {
				// Live-preview shape elements by restoring to start-drag state
				if (drawingHistory.length > 0) {
					freshCtx.putImageData(drawingHistory[drawingHistory.length - 1], 0, 0);
				}

				if (currentTool === 'rect') {
					freshCtx.beginPath();
					freshCtx.rect(dragStartX, dragStartY, coords.x - dragStartX, coords.y - dragStartY);
					freshCtx.strokeStyle = drawColor;
					freshCtx.lineWidth = 3;
					freshCtx.stroke();
				} 
				else if (currentTool === 'redact') {
					freshCtx.fillStyle = '#08090a';
					freshCtx.fillRect(dragStartX, dragStartY, coords.x - dragStartX, coords.y - dragStartY);
					freshCtx.strokeStyle = 'rgba(255, 255, 255, 0.1)';
					freshCtx.lineWidth = 1;
					freshCtx.strokeRect(dragStartX, dragStartY, coords.x - dragStartX, coords.y - dragStartY);
				} 
				else if (currentTool === 'arrow') {
					drawArrowMarker(freshCtx, dragStartX, dragStartY, coords.x, coords.y);
				}
			}
		});

		freshCanvas.addEventListener('mouseup', () => {
			isDrawingOnCanvas = false;
		});

		// HUD Controls Hooks
		const toolButtons = document.querySelectorAll('.modal-hud-toolbar .hud-btn');
		toolButtons.forEach((btn) => {
			btn.addEventListener('click', (e) => {
				toolButtons.forEach(b => b.classList.remove('active'));
				const target = e.currentTarget as HTMLElement;
				target.classList.add('active');
				currentTool = target.getAttribute('data-tool') || 'pen';
			});
		});

		const colorDots = document.querySelectorAll('.modal-hud-toolbar .hud-color-dot');
		colorDots.forEach((dot) => {
			dot.addEventListener('click', (e) => {
				colorDots.forEach(d => d.classList.remove('active'));
				const target = e.currentTarget as HTMLElement;
				target.classList.add('active');
				drawColor = target.getAttribute('data-color') || '#ff453a';
			});
		});

		const undoBtn = document.getElementById('hud-undo-btn');
		if (undoBtn) {
			undoBtn.addEventListener('click', () => {
				if (drawingHistory.length > 0) {
					const state = drawingHistory.pop();
					if (state) freshCtx.putImageData(state, 0, 0);
				} else {
					freshCtx.clearRect(0, 0, freshCanvas.width, freshCanvas.height);
				}
			});
		}

		const clearBtn = document.getElementById('hud-clear-btn');
		if (clearBtn) {
			clearBtn.addEventListener('click', () => {
				saveState();
				freshCtx.clearRect(0, 0, freshCanvas.width, freshCanvas.height);
			});
		}
	}

	function drawArrowMarker(ctx: CanvasRenderingContext2D, fromX: number, fromY: number, toX: number, toY: number) {
		const headLength = 12; // arrow head length
		const angle = Math.atan2(toY - fromY, toX - fromX);

		ctx.beginPath();
		ctx.moveTo(fromX, fromY);
		ctx.lineTo(toX, toY);
		ctx.strokeStyle = drawColor;
		ctx.lineWidth = 3;
		ctx.lineCap = 'round';
		ctx.stroke();

		ctx.beginPath();
		ctx.moveTo(toX, toY);
		ctx.lineTo(toX - headLength * Math.cos(angle - Math.PI / 6), toY - headLength * Math.sin(angle - Math.PI / 6));
		ctx.lineTo(toX - headLength * Math.cos(angle + Math.PI / 6), toY - headLength * Math.sin(angle + Math.PI / 6));
		ctx.closePath();
		ctx.fillStyle = drawColor;
		ctx.fill();
	}

	// -------------------------------------------------------------
	// Modal Customizer Options (Beautify Studio)
	// -------------------------------------------------------------
	if (modalPaddingSlider && modalBeautifyCanvas) {
		modalPaddingSlider.addEventListener('input', (e) => {
			const target = e.target as HTMLInputElement;
			modalBeautifyCanvas.style.padding = `${target.value}px`;
		});
	}

	if (modalShadowToggle && modalBeautifyImg) {
		modalShadowToggle.addEventListener('change', (e) => {
			const target = e.target as HTMLInputElement;
			const imgWrapper = document.getElementById('modal-beautify-img-wrapper');
			if (imgWrapper) {
				imgWrapper.style.boxShadow = target.checked ? '0 20px 45px rgba(0,0,0,0.5)' : 'none';
			}
		});
	}

	if (modalGradientPickers && modalBeautifyCanvas) {
		const dots = modalGradientPickers.querySelectorAll('.gradient-dot');
		dots.forEach((dot) => {
			dot.addEventListener('click', (e) => {
				dots.forEach(d => d.classList.remove('active'));
				const target = e.currentTarget as HTMLElement;
				target.classList.add('active');
				
				const grad = target.getAttribute('data-grad') || '';
				modalBeautifyCanvas.style.background = grad;

				// Toggle panel slider display if "none" is chosen
				const paddingGroup = document.getElementById('modal-padding-group');
				const shadowGroup = document.getElementById('modal-shadow-group');
				if (grad === 'none') {
					modalBeautifyCanvas.style.padding = '0';
					if (paddingGroup) paddingGroup.style.display = 'none';
					if (shadowGroup) shadowGroup.style.display = 'none';
				} else {
					modalBeautifyCanvas.style.padding = `${modalPaddingSlider.value}px`;
					if (paddingGroup) paddingGroup.style.display = 'flex';
					if (shadowGroup) shadowGroup.style.display = 'flex';
				}
			});
		});
	}

	// -------------------------------------------------------------
	// Export Studio Canvas (Merge elements & download)
	// -------------------------------------------------------------
	if (modalDownloadBtn && modalBeautifyCanvas) {
		modalDownloadBtn.addEventListener('click', async () => {
			modalDownloadBtn.textContent = 'Processing Export...';
			try {
				const h2c = await loadHtml2Canvas();
				const canvas = await h2c(modalBeautifyCanvas, {
					backgroundColor: null,
					useCORS: true,
					logging: false
				});
				const link = document.createElement('a');
				link.download = 'aeroshot_studio_export.png';
				link.href = canvas.toDataURL('image/png');
				link.click();
				modalDownloadBtn.innerHTML = `
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
						<polyline points="7 10 12 15 17 10"/>
						<line x1="12" y1="15" x2="12" y2="3"/>
					</svg> Export Styled Image`;
			} catch (err) {
				console.error('Modal canvas render failed:', err);
				modalDownloadBtn.textContent = 'Export Failed';
			}
		});
	}

	// -------------------------------------------------------------
	// Inline OCR Reader inside Studio Modal
	// -------------------------------------------------------------
	if (modalOcrTriggerBtn && modalOcrTextbox && modalOcrStatus) {
		modalOcrTriggerBtn.addEventListener('click', () => {
			modalOcrTextbox.value = '// Scanning image layers...';
			modalOcrStatus.textContent = 'Scanning...';
			modalOcrStatus.classList.add('active');
			modalOcrTriggerBtn.disabled = true;

			setTimeout(() => {
				modalOcrStatus.textContent = 'Copied!';
				const resultText = window.currentWebCropText || '[No text detected in crop]';
				modalOcrTextbox.value = resultText;
				
				// Copy inline result to clipboard
				navigator.clipboard.writeText(resultText).catch(() => {});
				modalOcrTriggerBtn.disabled = false;
				modalOcrTriggerBtn.textContent = 'Read Text again';
			}, 1200);
		});
	}

	if (modalOcrCopyBtn && modalOcrTextbox) {
		modalOcrCopyBtn.addEventListener('click', () => {
			const text = modalOcrTextbox.value;
			if (text && !text.startsWith('//')) {
				navigator.clipboard.writeText(text).then(() => {
					modalOcrCopyBtn.textContent = 'Copied!';
					setTimeout(() => {
						modalOcrCopyBtn.textContent = 'Copy Text';
					}, 1500);
				}).catch(() => {});
			}
		});
	}

	// Quick Action: Copy (direct from thumbnail)
	if (thumbActCopy && thumbnailToast && desktopThumbnail) {
		thumbActCopy.addEventListener('click', (e) => {
			e.stopPropagation();

			// Show copied state
			thumbnailToast.classList.add('active');

			if (window.currentWebCrop) {
				// Copy raw data URL or placeholder success
			}

			// Hide thumbnail after toast display
			setTimeout(() => {
				thumbnailToast.classList.remove('active');
				desktopThumbnail.classList.remove('show');
			}, 1500);
		});
	}

	// Reset auto-dismiss timer on thumbnail hover
	if (desktopThumbnail) {
		desktopThumbnail.addEventListener('mouseenter', () => clearTimeout(dismissTimeout));
		desktopThumbnail.addEventListener('mouseleave', () => triggerThumbnailDismissTimer());
	}


	// -------------------------------------------------------------
	// 3D Exploded Anatomy Slider Control & Guides
	// -------------------------------------------------------------
	const explodeSlider = document.getElementById('explode-slider') as HTMLInputElement;
	const explodeVal = document.getElementById('explode-val');
	const scene3d = document.getElementById('scene-3d');

	if (explodeSlider && explodeVal && scene3d) {
		explodeSlider.addEventListener('input', (e) => {
			const target = e.target as HTMLInputElement;
			const val = target.value;
			explodeVal.textContent = `${val}px Depth`;
			scene3d.style.setProperty('--explode-depth', `${val}px`);
		});
	}

	// 3D Layer Hover Guide link
	const indicatorItems = document.querySelectorAll('.indicator-item');
	const explodeLayers = document.querySelectorAll('.explode-layer');

	indicatorItems.forEach((item) => {
		item.addEventListener('mouseenter', () => {
			const idx = item.getAttribute('data-layer');
			indicatorItems.forEach(i => i.classList.remove('active'));
			item.classList.add('active');

			explodeLayers.forEach((layer) => {
				const styleAttr = layer.getAttribute('style') || '';
				const match = styleAttr.match(/--layer-index:\s*(\d+)/);
				const layerIdx = match ? match[1] : null;
				if (layerIdx === idx) {
					layer.classList.add('highlighted');
				} else {
					layer.classList.remove('highlighted');
				}
			});
		});

		item.addEventListener('mouseleave', () => {
			explodeLayers.forEach(layer => layer.classList.remove('highlighted'));
			item.classList.remove('active');
		});
	});

	// Mouse tilt effect for 3D Visualizer Box
	const visualizerContainer = document.getElementById('exploded-container');
	
	if (visualizerContainer && scene3d) {
		visualizerContainer.addEventListener('mousemove', (e: MouseEvent) => {
			const rect = visualizerContainer.getBoundingClientRect();
			const x = e.clientX - rect.left - rect.width / 2;
			const y = e.clientY - rect.top - rect.height / 2;
			
			const tiltX = -(y / rect.height) * 24;
			const tiltY = (x / rect.width) * 24;
			
			scene3d.style.transform = `rotateX(${60 + tiltX}deg) rotateZ(${-30 + tiltY}deg)`;
		});

		visualizerContainer.addEventListener('mouseleave', () => {
			scene3d.style.transform = 'rotateX(60deg) rotateZ(-30deg)';
		});
	}

	// -------------------------------------------------------------
	// Features Section: Toggles & Interactive Sandboxes
	// -------------------------------------------------------------
	const toggleBeautifyBtn = document.getElementById('toggle-beautify');
	const beautifyBackdrop = document.getElementById('beautify-backdrop');

	if (toggleBeautifyBtn && beautifyBackdrop) {
		toggleBeautifyBtn.addEventListener('click', () => {
			beautifyBackdrop.classList.toggle('beautified');
			
			if (beautifyBackdrop.classList.contains('beautified')) {
				toggleBeautifyBtn.textContent = 'Reset Mockup';
				toggleBeautifyBtn.classList.add('btn-primary');
			} else {
				toggleBeautifyBtn.textContent = 'Toggle Beautify';
				toggleBeautifyBtn.classList.remove('btn-primary');
			}
		});
	}

	const triggerOcrBtn = document.getElementById('trigger-ocr');
	const ocrOverlay = document.getElementById('ocr-overlay');
	const ocrOutputText = document.getElementById('ocr-output-text');
	const ocrStatus = document.getElementById('ocr-status');
	const arrowIcon = document.querySelector('.ocr-result-arrow');

	if (triggerOcrBtn && ocrOverlay && ocrOutputText && ocrStatus && arrowIcon) {
		let isScanning = false;

		triggerOcrBtn.addEventListener('click', () => {
			if (isScanning) return;
			isScanning = true;

			if (triggerOcrBtn.textContent === 'Reset OCR Simulation') {
				// Reset to default Wittgenstein quote
				const ocrImageWrap = document.getElementById('ocr-source-image-wrap');
				if (ocrImageWrap) {
					ocrImageWrap.innerHTML = `
						<p class="embedded-text">"The limits of my language mean the limits of my world."</p>
						<p class="author-text">— Ludwig Wittgenstein</p>
					`;
				}
				ocrOutputText.innerHTML = '// Click "Simulate OCR" to extract text...';
				ocrStatus.textContent = 'Ready';
				ocrStatus.classList.remove('active');
				arrowIcon.classList.remove('active');
				triggerOcrBtn.textContent = 'Simulate OCR';
				triggerOcrBtn.classList.remove('btn-primary');
				isScanning = false;
				return;
			}

			ocrOutputText.innerHTML = '// Extracting...';
			ocrOverlay.classList.add('scanning');
			ocrStatus.textContent = 'Scanning Screen...';
			ocrStatus.classList.add('active');
			arrowIcon.classList.add('active');
			triggerOcrBtn.disabled = true;

			setTimeout(() => {
				ocrOverlay.classList.remove('scanning');
				ocrStatus.textContent = 'Copying...';
				
				setTimeout(() => {
					ocrOutputText.innerHTML = `<span class="ocr-copied-highlight">"The limits of my language mean the limits of my world."<br/>— Ludwig Wittgenstein</span>`;
					ocrStatus.textContent = 'Copied to Clipboard!';
					triggerOcrBtn.textContent = 'Reset OCR Simulation';
					triggerOcrBtn.disabled = false;
					triggerOcrBtn.classList.add('btn-primary');
					isScanning = false;
				}, 1000);
			}, 1200);
		});
	}

	// Start DOM hooks
	setupWebCrop();
</script>
