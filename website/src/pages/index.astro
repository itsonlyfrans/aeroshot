	// 3D Layer Hover Guide link
	const indicatorItems = document.querySelectorAll('.indicator-item');
	const explodeLayers = document.querySelectorAll('.explode-layer');

	indicatorItems.forEach((item) => {
		item.addEventListener('mouseenter', () => {
			const idx = item.getAttribute('data-layer');
			indicatorItems.forEach(i => i.classList.remove('active'));
			item.classList.add('active');

			explodeLayers.forEach((layer) => {
				const styleAttr = layer.getAttribute('style') || '';
				const match = styleAttr.match(/--layer-index:\s*(\d+)/);
				const layerIdx = match ? match[1] : null;
				if (layerIdx === idx) {
					layer.classList.add('highlighted');
				} else {
					layer.classList.remove('highlighted');
				}
			});
		});

		item.addEventListener('mouseleave', () => {
			explodeLayers.forEach(layer => layer.classList.remove('highlighted'));
			item.classList.remove('active');
		});
	});

	// Mouse tilt effect for 3D Visualizer Box
	const visualizerContainer = document.getElementById('exploded-container');
	
	if (visualizerContainer && scene3d) {
		visualizerContainer.addEventListener('mousemove', (e: MouseEvent) => {
			const rect = visualizerContainer.getBoundingClientRect();
			const x = e.clientX - rect.left - rect.width / 2;
			const y = e.clientY - rect.top - rect.height / 2;
			
			const tiltX = -(y / rect.height) * 24;
			const tiltY = (x / rect.width) * 24;
			
			scene3d.style.transform = `rotateX(${60 + tiltX}deg) rotateZ(${-30 + tiltY}deg)`;
		});

		visualizerContainer.addEventListener('mouseleave', () => {
			scene3d.style.transform = 'rotateX(60deg) rotateZ(-30deg)';
		});
	}

	// -------------------------------------------------------------
	// Features Section: Toggles & Interactive Sandboxes
	// -------------------------------------------------------------
	const toggleBeautifyBtn = document.getElementById('toggle-beautify');
	const beautifyBackdrop = document.getElementById('beautify-backdrop');

	if (toggleBeautifyBtn && beautifyBackdrop) {
		toggleBeautifyBtn.addEventListener('click', () => {
			beautifyBackdrop.classList.toggle('beautified');
			
			if (beautifyBackdrop.classList.contains('beautified')) {
				toggleBeautifyBtn.textContent = 'Reset Mockup';
				toggleBeautifyBtn.classList.add('btn-primary');
			} else {
				toggleBeautifyBtn.textContent = 'Toggle Beautify';
				toggleBeautifyBtn.classList.remove('btn-primary');
			}
		});
	}

	const triggerOcrBtn = document.getElementById('trigger-ocr');
	const ocrOverlay = document.getElementById('ocr-overlay');
	const ocrOutputText = document.getElementById('ocr-output-text');
	const ocrStatus = document.getElementById('ocr-status');
	const arrowIcon = document.querySelector('.ocr-result-arrow');

	if (triggerOcrBtn && ocrOverlay && ocrOutputText && ocrStatus && arrowIcon) {
		let isScanning = false;

		triggerOcrBtn.addEventListener('click', () => {
			if (isScanning) return;
			isScanning = true;

			if (triggerOcrBtn.textContent === 'Reset OCR Simulation') {
				// Reset to default Wittgenstein quote
				const ocrImageWrap = document.getElementById('ocr-source-image-wrap');
				if (ocrImageWrap) {
					ocrImageWrap.innerHTML = `
						<p class="embedded-text">"The limits of my language mean the limits of my world."</p>
						<p class="author-text">— Ludwig Wittgenstein</p>
					`;
				}
				ocrOutputText.innerHTML = '// Click "Simulate OCR" to extract text...';
				ocrStatus.textContent = 'Ready';
				ocrStatus.classList.remove('active');
				arrowIcon.classList.remove('active');
				triggerOcrBtn.textContent = 'Simulate OCR';
				triggerOcrBtn.classList.remove('btn-primary');
				isScanning = false;
				return;
			}

			ocrOutputText.innerHTML = '// Extracting...';
			ocrOverlay.classList.add('scanning');
			ocrStatus.textContent = 'Scanning Screen...';
			ocrStatus.classList.add('active');
			arrowIcon.classList.add('active');
			triggerOcrBtn.disabled = true;

			setTimeout(() => {
				ocrOverlay.classList.remove('scanning');
				ocrStatus.textContent = 'Copying...';
				
				setTimeout(() => {
					ocrOutputText.innerHTML = `<span class="ocr-copied-highlight">"The limits of my language mean the limits of my world."<br/>— Ludwig Wittgenstein</span>`;
					ocrStatus.textContent = 'Copied to Clipboard!';
					triggerOcrBtn.textContent = 'Reset OCR Simulation';
					triggerOcrBtn.disabled = false;
					triggerOcrBtn.classList.add('btn-primary');
					isScanning = false;
				}, 1000);
			}, 1200);
		});
	}

	// -------------------------------------------------------------
	// 1. SMART PII CLOAKING SIMULATOR
	// -------------------------------------------------------------
	const btnToggleCloak = document.getElementById('btn-toggle-cloak');
	const piiLaser = document.getElementById('pii-laser');
	const cloakStatus = document.getElementById('cloak-status');
	const piiElements = document.querySelectorAll('.pii-data');

	if (btnToggleCloak && piiLaser && cloakStatus) {
		let isCloaked = false;

		btnToggleCloak.addEventListener('click', () => {
			// Trigger laser sweep animation
			piiLaser.classList.remove('scanning');
			void piiLaser.offsetWidth;
			piiLaser.classList.add('scanning');

			btnToggleCloak.disabled = true;

			setTimeout(() => {
				isCloaked = !isCloaked;
				
				piiElements.forEach((el) => {
					const element = el as HTMLElement;
					if (isCloaked) {
						element.textContent = element.getAttribute('data-mock');
						element.classList.add('cloaked');
					} else {
						element.textContent = element.getAttribute('data-raw');
						element.classList.remove('cloaked');
					}
				});

				if (isCloaked) {
					btnToggleCloak.textContent = '🔓 Disable PII Cloaking';
					btnToggleCloak.classList.add('btn-primary');
					cloakStatus.textContent = 'Cloaked Mode';
					cloakStatus.style.borderColor = 'rgba(48, 209, 88, 0.3)';
					cloakStatus.style.background = 'rgba(48, 209, 88, 0.08)';
					cloakStatus.style.color = '#30d158';
				} else {
					btnToggleCloak.textContent = '🔒 Enable PII Cloaking';
					btnToggleCloak.classList.remove('btn-primary');
					cloakStatus.textContent = 'Live Mode';
					cloakStatus.style.borderColor = 'rgba(255, 69, 58, 0.2)';
					cloakStatus.style.background = 'rgba(255, 69, 58, 0.08)';
					cloakStatus.style.color = '#ff453a';
				}
				btnToggleCloak.disabled = false;
			}, 600);
		});
	}

	// -------------------------------------------------------------
	// 2. SCREENSHOT TIMELINE
	// -------------------------------------------------------------
	const tlViewer    = document.getElementById('tl-viewer');
	const tlFlash     = document.getElementById('tl-capture-flash');
	const tlBadge     = document.getElementById('tl-badge-text');
	const tlMarkers   = document.querySelectorAll('.tl-marker');

	const tlVersionLabels = [
		'Empty canvas — data not loaded',
		'Dashboard populated with live data',
		'Redesign: accent → green, chart grew',
		'v4 · Final polish, peak metrics ✓'
	];

	if (tlViewer && tlFlash && tlBadge && tlMarkers.length) {
		tlMarkers.forEach((marker) => {
			marker.addEventListener('click', () => {
				const version = parseInt((marker as HTMLElement).dataset.version ?? '0', 10);

				// Deactivate all markers, activate clicked
				tlMarkers.forEach(m => m.classList.remove('active'));
				marker.classList.add('active');

				// Flash (simulates shutter capture)
				tlFlash.classList.add('flash');
				setTimeout(() => tlFlash.classList.remove('flash'), 120);

				// Switch viewer state → CSS handles all visual transitions
				tlViewer.dataset.state = String(version);

				// Update badge
				tlBadge.textContent = tlVersionLabels[version];
			});
		});
	}


	// -------------------------------------------------------------
	// 3. ACTIONABLE OCR MACRO SIMULATOR
	// -------------------------------------------------------------
	const btnRunOcrMacros = document.getElementById('btn-run-ocr-macros');
	const ocrFlowArrow = document.getElementById('ocr-flow-arrow');
	const ocrMacrosHud = document.getElementById('ocr-macros-hud');
	const macroBtnJson = document.getElementById('macro-btn-json');
	const macroBtnColor = document.getElementById('macro-btn-color');
	const macroBtnDebug = document.getElementById('macro-btn-debug');
	
	let ocrScannedText = '';

	if (btnRunOcrMacros && ocrOutputText && ocrStatus && ocrFlowArrow && ocrMacrosHud) {
		btnRunOcrMacros.addEventListener('click', () => {
			if (btnRunOcrMacros.textContent === 'Reset Simulator') {
				ocrOutputText.innerHTML = '// Click "Scan & Run Macros" to process...';
				ocrStatus.textContent = 'Ready';
				ocrStatus.classList.remove('active');
				ocrFlowArrow.classList.remove('active');
				ocrMacrosHud.classList.remove('active');
				btnRunOcrMacros.textContent = '⚡ Scan & Run Macros';
				btnRunOcrMacros.classList.remove('btn-primary');
				return;
			}

			ocrOutputText.innerHTML = '// Running OCR syntax scanning...';
			ocrFlowArrow.classList.add('active');
			ocrStatus.textContent = 'Parsing elements...';
			ocrStatus.classList.add('active');
			btnRunOcrMacros.disabled = true;

			setTimeout(() => {
				ocrScannedText = '[Error] Build compilation failed.\nSyntax Color: #0a84ff\nPayload: {"status":"error","code":500,"msg":"database connection offset timeout"}';
				ocrOutputText.textContent = ocrScannedText;
				ocrStatus.textContent = 'Elements Captured!';
				
				// Reveal contextual macro HUD
				ocrMacrosHud.classList.add('active');
				
				btnRunOcrMacros.textContent = 'Reset Simulator';
				btnRunOcrMacros.classList.add('btn-primary');
				btnRunOcrMacros.disabled = false;
			}, 1000);
		});
	}

	// Macro Actions implementations
	if (macroBtnJson && ocrOutputText) {
		macroBtnJson.addEventListener('click', () => {
			const jsonString = '{"status":"error","code":500,"msg":"database connection offset timeout"}';
			try {
				const parsed = JSON.parse(jsonString);
				const formatted = JSON.stringify(parsed, null, 2);
				ocrOutputText.innerHTML = `<span class="ocr-copied-highlight">${formatted}</span>`;
				
				// Copy to clipboard
				navigator.clipboard.writeText(formatted).catch(() => {});
				
				macroBtnJson.textContent = 'Formatted & Copied!';
				setTimeout(() => {
					macroBtnJson.textContent = '🔧 Format JSON';
				}, 1500);
			} catch (e) {}
		});
	}

	if (macroBtnColor) {
		macroBtnColor.addEventListener('click', () => {
			const swiftColorCode = 'Color(red: 10/255, green: 132/255, blue: 255/255) // #0a84ff';
			navigator.clipboard.writeText(swiftColorCode).then(() => {
				if (ocrOutputText) {
					ocrOutputText.innerHTML = `<span class="ocr-copied-highlight">${swiftColorCode}</span>`;
				}
				macroBtnColor.textContent = 'Swift Code Copied!';
				setTimeout(() => {
					macroBtnColor.textContent = '🎨 Copy Swift Color';
				}, 1500);
			}).catch(() => {});
		});
	}

	if (macroBtnDebug) {
		macroBtnDebug.addEventListener('click', () => {
			const errorMsg = 'database connection offset timeout';
			const searchUrl = `https://stackoverflow.com/search?q=database+connection+offset+timeout`;
			window.open(searchUrl, '_blank');
			
			macroBtnDebug.textContent = 'Search Opened!';
			setTimeout(() => {
				macroBtnDebug.textContent = '🔍 Debug Error';
			}, 1500);
		});
	}

	// Start DOM hooks
	setupWebCrop();
</script>
