---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<!-- Simulated macOS Menu Bar -->
	<div class="macos-menubar">
		<div class="menubar-left">
			<span class="menubar-item logo-"></span>
			<span class="menubar-item app-name" style="font-weight: 700;">Aeroshot</span>
			<span class="menubar-item">File</span>
			<span class="menubar-item">Edit</span>
			<span class="menubar-item">Capture</span>
			<span class="menubar-item">Window</span>
			<span class="menubar-item">Help</span>
		</div>
		<div class="menubar-right">
			<!-- Aeroshot Tray Icon Dropdown -->
			<div class="menubar-tray-wrapper" id="tray-icon-wrapper">
				<svg class="tray-logo" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M3 8 V5 a2 2 0 0 1 2-2 h3"/>
					<path d="M16 3 h3 a2 2 0 0 1 2 2 v3"/>
					<path d="M21 16 v3 a2 2 0 0 1-2 2 h-3"/>
					<path d="M8 21 H5 a2 2 0 0 1-2-2 v-3"/>
					<path d="M17 7 L7 11.5 L11 13 L12.5 17 Z" fill="currentColor" stroke="none"/>
				</svg>
				<div class="tray-dropdown-menu" id="tray-dropdown">
					<div class="dropdown-header">Capture Presets</div>
					<button class="dropdown-item" id="tray-act-crop">
						<span>Capture Selection Area</span>
						<span class="dropdown-shortcut">C</span>
					</button>
					<button class="dropdown-item" id="tray-act-full">
						<span>Capture Full Screen</span>
						<span class="dropdown-shortcut">F</span>
					</button>
					<button class="dropdown-item" id="tray-act-ocr">
						<span>Extract Text (OCR)</span>
						<span class="dropdown-shortcut">O</span>
					</button>
					<div class="dropdown-divider"></div>
					<div class="dropdown-header">Studio Workspace</div>
					<button class="dropdown-item" id="tray-act-studio">
						<span>Open Markup Studio...</span>
					</button>
				</div>
			</div>
			<span class="menubar-item-icon">📶</span>
			<span class="menubar-item-icon" style="font-size: 11px;">🔋 100%</span>
			<span class="menubar-clock" id="menubar-clock">Sat 8:42 PM</span>
		</div>
	</div>

	<!-- Header -->
	<header class="header">
		<div class="container header-container">
			<a href="#" class="logo">
				<svg class="logo-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M3 8 V5 a2 2 0 0 1 2-2 h3"/>
					<path d="M16 3 h3 a2 2 0 0 1 2 2 v3"/>
					<path d="M21 16 v3 a2 2 0 0 1-2 2 h-3"/>
					<path d="M8 21 H5 a2 2 0 0 1-2-2 v-3"/>
					<path d="M17 7 L7 11.5 L11 13 L12.5 17 Z" fill="currentColor" stroke="none"/>
				</svg>
				<span class="logo-text">Aeroshot</span>
			</a>
			<nav class="nav">
				<a href="#features" class="nav-link">Features</a>
				<a href="#anatomy" class="nav-link">3D Anatomy</a>
				<a href="#demo" class="nav-link">Interactive Demo</a>
				<a href="#faq" class="nav-link">FAQ</a>
			</nav>
			<div class="header-actions">
				<a href="#" class="btn btn-secondary btn-sm" id="download-header-btn">Download</a>
			</div>
		</div>
	</header>

	<main>
		<!-- Hero Section -->
		<section class="hero glow-effect">
			<div class="container hero-container animate-fade-in-up">
				<div class="badge">macOS Utility</div>
				<h1 class="hero-title">Screenshots at the <br/><span class="gradient-text">speed of thought</span></h1>
				<p class="hero-subtitle">
					A professional screen capture tool for macOS. Take stunning captures, record flawless GIFs/videos, annotate bugs instantly, and extract text via high-precision OCR.
				</p>
				<div class="hero-ctas">
					<a href="#" class="btn btn-primary btn-lg">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
							<polyline points="7 10 12 15 17 10"/>
							<line x1="12" y1="15" x2="12" y2="3"/>
						</svg>
						Download for macOS
					</a>
					<button class="btn btn-secondary btn-lg" id="try-live-capture-btn">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M3 8V5a2 2 0 0 1 2-2h3"/>
							<path d="M16 3h3a2 2 0 0 1 2 2v3"/>
							<path d="M21 16v3a2 2 0 0 1-2 2h-3"/>
							<path d="M8 21H5a2 2 0 0 1-2-2v-3"/>
							<line x1="12" y1="8" x2="12" y2="16"/>
							<line x1="8" y1="12" x2="16" y2="12"/>
						</svg>
						Try Live Web Capture
					</button>
				</div>

				<!-- Floating Mockup Window with Click-to-Capture -->
				<div class="hero-mockup-wrapper">
					<p class="mockup-hint">Click the window below to take a screenshot</p>
					<div class="mockup-window glass-card" id="hero-capture-window">
						<div class="window-header">
							<div class="window-dots">
								<span class="dot red"></span>
								<span class="dot yellow"></span>
								<span class="dot green"></span>
							</div>
							<div class="window-title">Aeroshot — Click Screen to Capture</div>
						</div>
						<div class="window-content selection-canvas clickable-canvas">
							<!-- Click to Capture CTA Overlay -->
							<div class="capture-overlay-cta">
								<svg class="camera-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
									<circle cx="12" cy="13" r="4"/>
								</svg>
								<span>Click Window to Capture</span>
							</div>

							<!-- Viewfinder Crop Bracket Box -->
							<div class="selection-rect hero-selection-rect">
								<div class="bracket-lines tl"></div>
								<div class="bracket-lines tr"></div>
								<div class="bracket-lines bl"></div>
								<div class="bracket-lines br"></div>
								<div class="selection-badge">Selection Area — W: 824px · H: 450px</div>
							</div>
							<div class="grid-mock-lines"></div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Features Grid Section -->
		<section id="features" class="features-section">
			<div class="container">
				<div class="section-header">
					<h2 class="section-title">Engineered for your workflow</h2>
					<p class="section-subtitle">Aeroshot elevates daily screen captures into high-value evidence, tutorials, and reusable assets.</p>
				</div>
				
				<div class="features-grid">
					<!-- Prove Feature -->
					<div class="glass-card feature-card">
						<div class="feature-icon-wrapper red-glow">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ff453a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
								<polyline points="14 2 14 8 20 8"/>
								<line x1="16" y1="13" x2="8" y2="13"/>
								<line x1="16" y1="17" x2="8" y2="17"/>
								<polyline points="10 9 9 9 8 9"/>
							</svg>
						</div>
						<h3>1. Prove</h3>
						<p>Perfect for bug reports and QA documentation. Attach precise annotation steps, dimensions, and generate clean filenames with structured templates automatically.</p>
						<div class="feature-preview">
							<div class="filename-tag"><code>aeroshot_Safari_2026-07-04_2042.png</code></div>
							<div class="annotation-mock">
								<span class="bug-tag">Bug found!</span>
								<svg class="arrow-svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#ff453a" stroke-width="2">
									<line x1="22" y1="2" x2="8" y2="16"/>
									<polyline points="12 16 8 16 8 12"/>
								</svg>
							</div>
						</div>
					</div>

					<!-- Teach Feature -->
					<div class="glass-card feature-card">
						<div class="feature-icon-wrapper green-glow">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#30d158" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
								<line x1="12" y1="18" x2="12" y2="6"/>
								<line x1="6" y1="12" x2="18" y2="12"/>
							</svg>
						</div>
						<h3>2. Teach</h3>
						<p>Record high-FPS MP4s and optimized GIFs for tutorials. Visualize mouse clicks with automatic ripple halos, toggle keyboard overlays, and add a webcam bubble overlay.</p>
						<div class="feature-preview timeline-preview">
							<div class="recording-badge-mock"><span class="rec-dot"></span> REC 00:04</div>
							<div class="cursor-mock">
								<div class="click-ripple"></div>
								<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
									<path d="M4.5 2.5v17.3l4.9-4.8 3.8 8.2 3.1-1.4-3.7-8.1 6.2-.2L4.5 2.5z"/>
								</svg>
							</div>
						</div>
					</div>

					<!-- Polish Feature (Interactive) -->
					<div class="glass-card feature-card feature-card-large" id="demo">
						<div class="feature-info-row">
							<div>
								<div class="feature-icon-wrapper blue-glow">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0a84ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<polygon points="12 2 2 7 12 12 22 7 12 2"/>
										<polyline points="2 17 12 22 22 17"/>
										<polyline points="2 12 17 22 12"/>
									</svg>
								</div>
								<h3>3. Polish & Share</h3>
								<p>Skip post-processing. Aeroshot instantly packages your active window with beautiful rounded padding, adjustable shadows, and custom gradient backdrops for instant sharing.</p>
							</div>
							<div class="demo-controls">
								<button id="toggle-beautify" class="btn btn-secondary btn-sm">Toggle Beautify</button>
							</div>
						</div>
						
						<!-- Beautify Interactive Sandbox -->
						<div class="beautify-sandbox">
							<div class="beautify-backdrop" id="beautify-backdrop">
								<div class="beautify-window" id="beautify-window">
									<div class="window-header">
										<div class="window-dots">
											<span class="dot red"></span>
											<span class="dot yellow"></span>
											<span class="dot green"></span>
										</div>
									</div>
									<div class="window-body-content">
										<p class="window-text-highlight">Terminal — git status</p>
										<code class="code-line">$ git status</code>
										<code class="code-line green-text">On branch main - clean working tree</code>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- OCR Feature (Interactive) -->
					<div class="glass-card feature-card feature-card-large" id="ocr-target-section">
						<div class="feature-info-row">
							<div>
								<div class="feature-icon-wrapper purple-glow">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#bf5af2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<polyline points="4 7 4 4 20 4 20 7"/>
										<line x1="9" y1="20" x2="15" y2="20"/>
										<line x1="12" y1="4" x2="12" y2="20"/>
									</svg>
								</div>
								<h3>4. Extract Text (OCR)</h3>
								<p>Grab text from non-selectable layouts, videos, or PDFs. Drag a crop box over any screen elements and Aeroshot will automatically parse text directly to your clipboard.</p>
							</div>
							<div class="demo-controls">
								<button id="trigger-ocr" class="btn btn-secondary btn-sm">Simulate OCR</button>
							</div>
						</div>

						<!-- OCR Interactive Sandbox -->
						<div class="ocr-sandbox">
							<div class="ocr-source-area" id="ocr-source">
								<div class="ocr-target-image" id="ocr-source-image-wrap">
									<p class="embedded-text">"The limits of my language mean the limits of my world."</p>
									<p class="author-text">— Ludwig Wittgenstein</p>
								</div>
								<div class="ocr-crop-overlay" id="ocr-overlay"></div>
							</div>
							<div class="ocr-result-arrow">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<line x1="5" y1="12" x2="19" y2="12"/>
									<polyline points="12 5 19 12 12 19"/>
								</svg>
							</div>
							<div class="ocr-destination-clipboard">
								<div class="clipboard-header">
									<span>Clipboard Output</span>
									<span class="clipboard-status" id="ocr-status">Ready</span>
								</div>
								<div class="clipboard-content">
									<code id="ocr-output-text">// Click "Simulate OCR" to extract text...</code>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 3D Anatomy Section -->
		<section id="anatomy" class="anatomy-section glow-effect">
			<div class="container anatomy-container">
				<div class="anatomy-info">
					<div class="badge">Advanced Engine</div>
					<h2>Anatomy of a Capture</h2>
					<p class="anatomy-desc">
						Aeroshot doesn't just copy pixels. It processes captures through five independent layers in milliseconds to create rich, high-fidelity mockups.
					</p>
					
					<!-- Range slider control -->
					<div class="explode-control-wrapper">
						<div class="slider-labels">
							<span>Compact View</span>
							<span class="active-val" id="explode-val">50px Depth</span>
							<span>Exploded Stack</span>
						</div>
						<input type="range" id="explode-slider" min="10" max="150" value="50" class="explode-slider" aria-label="Explode 3D Stack Depth" />
					</div>

					<!-- Layer guide indicators -->
					<div class="layer-indicators">
						<div class="indicator-item" data-layer="4">
							<span class="color-dot hud"></span>
							<div class="ind-text">
								<strong>Layer 5: Toolbar HUD</strong>
								<span>Floating quick-action controls</span>
							</div>
						</div>
						<div class="indicator-item" data-layer="3">
							<span class="color-dot ocr"></span>
							<div class="ind-text">
								<strong>Layer 4: OCR Boundary</strong>
								<span>Text reading coordinate grids</span>
							</div>
						</div>
						<div class="indicator-item" data-layer="2">
							<span class="color-dot annotation"></span>
							<div class="ind-text">
								<strong>Layer 3: Markups & Vectors</strong>
								<span>Lossless pointer lines and steps</span>
							</div>
						</div>
						<div class="indicator-item" data-layer="1">
							<span class="color-dot capture"></span>
							<div class="ind-text">
								<strong>Layer 2: Window Base</strong>
								<span>Target application pixel bounds</span>
							</div>
						</div>
						<div class="indicator-item" data-layer="0">
							<span class="color-dot canvas"></span>
							<div class="ind-text">
								<strong>Layer 1: Backdrop Shadow</strong>
								<span>Custom canvas padding and gradient</span>
							</div>
						</div>
					</div>
				</div>

				<!-- 3D Perspective Visualizer -->
				<div class="anatomy-visualizer-container" id="exploded-container">
					<p class="tilt-hint">Move mouse over container to tilt stack in 3D</p>
					<div class="scene-3d" id="scene-3d" style="--explode-depth: 50px;">
						
						<!-- Layer 5: Toolbar HUD -->
						<div class="explode-layer layer-hud" style="--layer-index: 4;">
							<div class="layer-header-label">Layer 5: Toolbar HUD</div>
							<div class="mock-hud-bar">
								<span class="hud-tool active">✏️</span>
								<span class="hud-tool">💬</span>
								<span class="hud-tool">🔲</span>
								<span class="hud-tool">🔍</span>
								<span class="hud-separator"></span>
								<span class="hud-tool download">📥</span>
							</div>
						</div>

						<!-- Layer 4: OCR Bounds -->
						<div class="explode-layer layer-ocr" style="--layer-index: 3;">
							<div class="layer-header-label">Layer 4: OCR Scan</div>
							<div class="mock-ocr-scan-line"></div>
							<div class="mock-ocr-box"></div>
							<span class="ocr-indicator-label">Scanning text...</span>
						</div>

						<!-- Layer 3: Annotations -->
						<div class="explode-layer layer-annotations" style="--layer-index: 2;">
							<div class="layer-header-label">Layer 3: Vector Annotations</div>
							<svg width="100%" height="100%" viewBox="0 0 100 100" class="mock-vector-annotations">
								<line x1="20" y1="25" x2="45" y2="40" stroke="#ff453a" stroke-width="1.5" stroke-dasharray="3 3"/>
								<circle cx="20" cy="25" r="3" fill="#ff453a"/>
								<path d="M 45 40 L 40 37 M 45 40 L 41 43" stroke="#ff453a" stroke-width="1.5"/>
								
								<rect x="50" y="60" width="30" height="15" rx="3" fill="none" stroke="#30d158" stroke-width="1.5"/>
								<circle cx="50" cy="60" r="3" fill="#30d158"/>
							</svg>
						</div>

						<!-- Layer 2: Window Base -->
						<div class="explode-layer layer-base" style="--layer-index: 1;">
							<div class="layer-header-label">Layer 2: Window Base</div>
							<div class="mock-base-window">
								<div class="window-header">
									<div class="window-dots">
										<span class="dot red"></span>
										<span class="dot yellow"></span>
										<span class="dot green"></span>
									</div>
								</div>
								<div class="base-content">
									<div class="base-text-line"></div>
									<div class="base-text-line short"></div>
									<div class="base-text-block"></div>
								</div>
							</div>
						</div>

						<!-- Layer 1: Backdrop Shadow -->
						<div class="explode-layer layer-canvas" style="--layer-index: 0;">
							<div class="layer-header-label">Layer 1: Canvas Background</div>
							<div class="mock-gradient-canvas"></div>
						</div>

					</div>
				</div>
			</div>
		</section>

		<!-- FAQ Section -->
		<section id="faq" class="faq-section">
			<div class="container">
				<div class="section-header">
					<h2 class="section-title">Frequently Asked Questions</h2>
				</div>
				<div class="faq-grid">
					<div class="glass-card faq-card">
						<h4>Is Aeroshot free?</h4>
						<p>Aeroshot is currently in open beta and completely free to use. When we launch 1.0, there will be a one-time lifetime license fee alongside a standard free tier.</p>
					</div>
					<div class="glass-card faq-card">
						<h4>Does it support scrolling screenshots?</h4>
						<p>Yes. You can capture long web pages, PDF documents, or chat windows that scroll vertically. Aeroshot will stitch them together perfectly.</p>
					</div>
					<div class="glass-card faq-card">
						<h4>Where are my recordings and screenshots saved?</h4>
						<p>By default, everything is copied to your clipboard and saved locally in your Pictures/Aeroshot folder. You can configure custom local destinations or trigger automations in settings.</p>
					</div>
					<div class="glass-card faq-card">
						<h4>What macOS versions are supported?</h4>
						<p>Aeroshot requires macOS 13 (Ventura) or newer, and is fully optimized for Apple Silicon (M1/M2/M3) as well as Intel chips.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Footer CTA -->
		<section class="footer-cta glow-effect">
			<div class="container footer-cta-container">
				<h2 class="gradient-text">Make every capture count</h2>
				<p>Download Aeroshot for macOS and experience the faster screen workflows today.</p>
				<a href="#" class="btn btn-primary btn-lg">Download for macOS</a>
			</div>
		</section>
	</main>

	<!-- Keyboard Shortcuts floating HUD guide -->
	<div class="shortcuts-guide-badge glass-card animate-fade-in-up">
		<div class="shortcut-tip-row"><kbd>C</kbd> <span>Crop Selection</span></div>
		<div class="shortcut-tip-row"><kbd>F</kbd> <span>Capture Fullscreen</span></div>
		<div class="shortcut-tip-row"><kbd>O</kbd> <span>Area OCR Reader</span></div>
	</div>

	<!-- Live Web Crop Overlay (Activated by button click or C/O hotkey) -->
	<div class="web-crop-overlay" id="web-crop-overlay">
		<div class="crop-instruction">Click & Drag to Select Screen Region · Press ESC to Cancel</div>
		<div class="crop-selection-box" id="crop-selection-box">
			<!-- Blue Viewfinder Bracket Corners -->
			<div class="crop-corner tl"></div>
			<div class="crop-corner tr"></div>
			<div class="crop-corner bl"></div>
			<div class="crop-corner br"></div>
			<div class="crop-size-badge" id="crop-size-badge">0 × 0</div>
		</div>
	</div>

	<!-- Floating macOS Screenshot Thumbnail (Spawned on Capture) -->
	<div class="floating-thumbnail glass-card" id="desktop-thumbnail">
		<button class="thumbnail-close-btn" id="thumbnail-close" aria-label="Dismiss screenshot">×</button>
		<div class="thumbnail-preview-img" id="thumbnail-preview-trigger">
			<div class="mini-preview-gradient"></div>
			<div class="mini-preview-lines">
				<span></span><span></span><span></span>
			</div>
		</div>
		<div class="thumbnail-actions-overlay">
			<button class="thumb-act-btn" id="thumb-act-polish">
				<span>🛠️ Studio</span>
			</button>
			<button class="thumb-act-btn" id="thumb-act-copy">
				<span>📋 Copy</span>
			</button>
		</div>
		<div class="thumbnail-copied-toast" id="thumbnail-toast">Copied to Clipboard!</div>
	</div>

	<!-- Beautify Studio Modal (Interactive Image Styler & Annotation Canvas) -->
	<div class="beautify-modal-overlay" id="beautify-modal">
