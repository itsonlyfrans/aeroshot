---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<!-- Simulated macOS Menu Bar -->
	<div class="macos-menubar">
		<div class="menubar-left">
			<span class="menubar-item logo-"></span>
			<span class="menubar-item app-name" style="font-weight: 700;">Aeroshot</span>
			<span class="menubar-item">File</span>
			<span class="menubar-item">Edit</span>
			<span class="menubar-item">Capture</span>
			<span class="menubar-item">Window</span>
			<span class="menubar-item">Help</span>
		</div>
		<div class="menubar-right">
			<!-- Aeroshot Tray Icon Dropdown -->
			<div class="menubar-tray-wrapper" id="tray-icon-wrapper">
				<svg class="tray-logo" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M3 8 V5 a2 2 0 0 1 2-2 h3"/>
					<path d="M16 3 h3 a2 2 0 0 1 2 2 v3"/>
					<path d="M21 16 v3 a2 2 0 0 1-2 2 h-3"/>
					<path d="M8 21 H5 a2 2 0 0 1-2-2 v-3"/>
					<path d="M17 7 L7 11.5 L11 13 L12.5 17 Z" fill="currentColor" stroke="none"/>
				</svg>
				<div class="tray-dropdown-menu" id="tray-dropdown">
					<div class="dropdown-header">Capture Presets</div>
					<button class="dropdown-item" id="tray-act-crop">
						<span>Capture Selection Area</span>
						<span class="dropdown-shortcut">C</span>
					</button>
					<button class="dropdown-item" id="tray-act-full">
						<span>Capture Full Screen</span>
						<span class="dropdown-shortcut">F</span>
					</button>
					<button class="dropdown-item" id="tray-act-ocr">
						<span>Extract Text (OCR)</span>
						<span class="dropdown-shortcut">O</span>
					</button>
					<div class="dropdown-divider"></div>
					<div class="dropdown-header">Studio Workspace</div>
					<button class="dropdown-item" id="tray-act-studio">
						<span>Open Markup Studio...</span>
					</button>
				</div>
			</div>
			<span class="menubar-item-icon">📶</span>
			<span class="menubar-item-icon" style="font-size: 11px;">🔋 100%</span>
			<span class="menubar-clock" id="menubar-clock">Sat 8:42 PM</span>
		</div>
	</div>

	<!-- Header -->
	<header class="header">
		<div class="container header-container">
			<a href="#" class="logo">
				<svg class="logo-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M3 8 V5 a2 2 0 0 1 2-2 h3"/>
					<path d="M16 3 h3 a2 2 0 0 1 2 2 v3"/>
					<path d="M21 16 v3 a2 2 0 0 1-2 2 h-3"/>
					<path d="M8 21 H5 a2 2 0 0 1-2-2 v-3"/>
					<path d="M17 7 L7 11.5 L11 13 L12.5 17 Z" fill="currentColor" stroke="none"/>
				</svg>
				<span class="logo-text">Aeroshot</span>
			</a>
			<nav class="nav">
				<a href="#features" class="nav-link">Features</a>
				<a href="#anatomy" class="nav-link">3D Anatomy</a>
				<a href="#demo" class="nav-link">Interactive Demo</a>
				<a href="#faq" class="nav-link">FAQ</a>
			</nav>
			<div class="header-actions">
				<a href="#" class="btn btn-secondary btn-sm" id="download-header-btn">Download</a>
			</div>
		</div>
	</header>

	<main>
		<!-- Hero Section -->
		<section class="hero glow-effect">
			<div class="container hero-container animate-fade-in-up">
				<div class="badge">macOS Utility</div>
				<h1 class="hero-title">Screenshots at the <br/><span class="gradient-text">speed of thought</span></h1>
				<p class="hero-subtitle">
					A professional screen capture tool for macOS. Take stunning captures, record flawless GIFs/videos, annotate bugs instantly, and extract text via high-precision OCR.
				</p>
				<div class="hero-ctas">
					<a href="#" class="btn btn-primary btn-lg">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
							<polyline points="7 10 12 15 17 10"/>
							<line x1="12" y1="15" x2="12" y2="3"/>
						</svg>
						Download for macOS
					</a>
					<button class="btn btn-secondary btn-lg" id="try-live-capture-btn">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M3 8V5a2 2 0 0 1 2-2h3"/>
							<path d="M16 3h3a2 2 0 0 1 2 2v3"/>
							<path d="M21 16v3a2 2 0 0 1-2 2h-3"/>
							<path d="M8 21H5a2 2 0 0 1-2-2v-3"/>
							<line x1="12" y1="8" x2="12" y2="16"/>
							<line x1="8" y1="12" x2="16" y2="12"/>
						</svg>
						Try Live Web Capture
					</button>
				</div>

				<!-- Floating Mockup Window with Click-to-Capture -->
				<div class="hero-mockup-wrapper">
					<p class="mockup-hint">Click the window below to take a screenshot</p>
					<div class="mockup-window glass-card" id="hero-capture-window">
						<div class="window-header">
							<div class="window-dots">
								<span class="dot red"></span>
								<span class="dot yellow"></span>
								<span class="dot green"></span>
							</div>
							<div class="window-title">Aeroshot — Click Screen to Capture</div>
						</div>
						<div class="window-content selection-canvas clickable-canvas">
							<!-- Click to Capture CTA Overlay -->
							<div class="capture-overlay-cta">
								<svg class="camera-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
									<circle cx="12" cy="13" r="4"/>
								</svg>
								<span>Click Window to Capture</span>
							</div>

							<!-- Viewfinder Crop Bracket Box -->
							<div class="selection-rect hero-selection-rect">
								<div class="bracket-lines tl"></div>
								<div class="bracket-lines tr"></div>
								<div class="bracket-lines bl"></div>
								<div class="bracket-lines br"></div>
								<div class="selection-badge">Selection Area — W: 824px · H: 450px</div>
							</div>
							<div class="grid-mock-lines"></div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Features Grid Section -->
		<section id="features" class="features-section">
			<div class="container">
				<div class="section-header">
					<h2 class="section-title">Engineered for your workflow</h2>
					<p class="section-subtitle">Aeroshot elevates daily screen captures into high-value evidence, tutorials, and reusable assets.</p>
				</div>
				
				<div class="features-grid">
					<!-- Prove Feature & Smart PII Cloaking Simulator -->
					<div class="glass-card feature-card">
						<div class="feature-info-row" style="margin-bottom: 12px; gap: 16px;">
							<div style="max-width: 100%;">
								<div class="feature-icon-wrapper red-glow">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ff453a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
									</svg>
								</div>
								<h3>1. Prove & Protect (PII Cloaking)</h3>
								<p>Log bugs without leaking info. Our on-device parser automatically identifies emails, API keys, and passwords, replacing them with formatted mock data instantly.</p>
							</div>
						</div>
						
						<!-- PII Cloaking Interactive Sandbox -->
						<div class="pii-simulator-box">
							<div class="pii-dashboard-mock">
								<div class="dashboard-header-mock">
									<div class="window-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
									<span style="font-family: monospace; font-size: 0.7rem; opacity: 0.6;">Stripe Dashboard — live_credentials</span>
								</div>
								<div class="dashboard-body-mock" id="pii-dashboard-body">
									<!-- Scanning laser line overlay -->
									<div class="pii-scanner-line" id="pii-laser"></div>
									
									<div class="db-row">
										<span class="db-label">Stripe API Key:</span>
										<span class="db-value pii-data" data-raw="sk_live_51Nz8P3K2mLxX8" data-mock="sk_test_•••••••••••••••••">sk_live_51Nz8P3K2mLxX8</span>
									</div>
									<div class="db-row">
										<span class="db-label">Account Email:</span>
										<span class="db-value pii-data" data-raw="alex.rivera@stripe.com" data-mock="developer_user@example.com">alex.rivera@stripe.com</span>
									</div>
									<div class="db-row">
										<span class="db-label">Monthly Payout:</span>
										<span class="db-value pii-data" data-raw="$14,852.50 USD" data-mock="$1,234.00 USD">$14,852.50 USD</span>
									</div>
								</div>
							</div>
							<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px; width: 100%;">
								<button class="btn btn-secondary btn-sm" id="btn-toggle-cloak">🔒 Enable PII Cloaking</button>
								<span class="cloak-status-label" id="cloak-status">Live Mode</span>
							</div>
						</div>
					</div>

					<!-- Teach Feature -->
					<div class="glass-card feature-card">
						<div class="feature-icon-wrapper green-glow">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#30d158" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"/>
								<polygon points="10 8 16 12 10 16 10 8" fill="#30d158" stroke="none"/>
							</svg>
						</div>
						<h3>2. Teach</h3>
						<p>Record a GIF or MP4 of exactly what you're doing — with automatic click halos and a keyboard overlay so viewers never lose track of the steps.</p>
						<!-- Step-by-step recording flow mockup -->
						<div class="teach-flow-preview">
							<div class="recording-badge-mock"><span class="rec-dot"></span> REC 00:07</div>
							<!-- Mock browser window being recorded -->
							<div class="teach-screen-mock">
								<div class="teach-mock-toolbar">
									<div class="window-dots" style="gap:5px;">
										<span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
									</div>
									<div class="teach-url-bar">github.com/your-org/repo/pull/42</div>
								</div>
								<div class="teach-mock-body">
									<!-- Step annotations overlaid on the recording -->
									<div class="teach-step" style="top: 28%; left: 18%;">
										<div class="step-num">①</div>
										<div class="step-label">Open PR</div>
									</div>
									<div class="teach-step" style="top: 54%; left: 50%;">
										<div class="step-num">②</div>
										<div class="step-label">Review diff</div>
									</div>
									<div class="teach-step" style="top: 75%; left: 72%;">
										<div class="step-num">③</div>
										<div class="step-label">Merge</div>
									</div>
									<!-- Animated cursor with click halo -->
									<div class="teach-cursor" id="teach-cursor">
										<div class="teach-click-halo"></div>
										<svg width="14" height="14" viewBox="0 0 24 24" fill="white">
											<path d="M4.5 2.5v17.3l4.9-4.8 3.8 8.2 3.1-1.4-3.7-8.1 6.2-.2L4.5 2.5z"/>
										</svg>
									</div>
								</div>
							</div>
							<!-- Keyboard overlay badge -->
							<div class="teach-kbd-overlay">
								<kbd>⌘</kbd><span style="opacity:0.4; font-size:0.65rem;">+</span><kbd>Return</kbd>
								<span class="kbd-action-label">Merge pull request</span>
							</div>
						</div>
					</div>

					<!-- Screenshot Timeline Feature -->
				<div class="glass-card feature-card feature-card-large" id="demo">
					<div class="feature-info-row">
						<div>
							<div class="feature-icon-wrapper blue-glow">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0a84ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="10"/>
									<polyline points="12 6 12 12 16 14"/>
								</svg>
							</div>
							<h3>3. Screenshot Timeline</h3>
							<p>Every capture is auto-tagged and stored. Click any point in the timeline below to jump to what your screen looked like at that moment — like <code>git log</code>, but visual.</p>
						</div>
						<!-- Live change badge -->
						<div class="tl-change-badge" id="tl-change-badge">
							<span class="tl-badge-dot"></span>
							<span id="tl-badge-text">Tap a version below</span>
						</div>
					</div>

					<!-- Real example: GitHub PR lifecycle across 4 captures -->
					<div class="tl-viewer" id="tl-viewer" data-state="0">
						<div class="pr-mock">

							<!-- PR Title Row -->
							<div class="pr-header">
								<div class="pr-title-row">
									<svg class="pr-git-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><line x1="6" y1="9" x2="6" y2="21"/>
									</svg>
									<span class="pr-title">feat: add dark mode toggle</span>
									<span class="pr-number">#247</span>
									<span class="pr-badge"></span>
								</div>
								<div class="pr-meta">
									<span class="pr-meta-author">opened by <strong>@owl</strong></span>
									<span class="pr-branch-pill">feature/dark-mode → main</span>
									<span class="pr-commits">3 commits · 2 files</span>
								</div>
							</div>

							<!-- CI Checks -->
							<div class="pr-section pr-checks-section">
								<div class="pr-section-label">Checks</div>
								<div class="pr-check-row">
									<span class="pr-check-icon ci-build-icon"></span>
									<span class="pr-check-name">CI / Build &amp; Lint</span>
									<span class="pr-check-result ci-build-result"></span>
								</div>
								<div class="pr-check-row">
									<span class="pr-check-icon ci-test-icon"></span>
									<span class="pr-check-name">Tests (24 suites)</span>
									<span class="pr-check-result ci-test-result"></span>
								</div>
							</div>

							<!-- Reviewers -->
							<div class="pr-section pr-reviewers-section">
								<div class="pr-section-label">Reviewers</div>
								<div class="pr-reviewer-row">
									<div class="pr-avatar">S</div>
									<span class="pr-reviewer-name">@sarah</span>
									<span class="pr-reviewer-status"></span>
								</div>
							</div>

							<!-- Review comment — visible from v2 onward -->
							<div class="pr-comment-thread">
								<div class="pr-comment-avatar">S</div>
								<div class="pr-comment-bubble">
									<span class="pr-comment-who">@sarah</span>
									<span class="pr-comment-text">Missing <code>aria-label</code> on the toggle — screen readers can't identify it.</span>
									<div class="pr-comment-reply">
										<span class="pr-reply-avatar">O</span>
										<span class="pr-reply-text">Fixed in <code>8f3a2d1</code> — added <code>aria-label="Toggle dark mode"</code> ✓</span>
									</div>
								</div>
							</div>

							<!-- Merge action area -->
							<div class="pr-merge-area">
								<div class="pr-merge-btn-wrap">
									<button class="pr-merge-btn">
										<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M5 3L19 12 5 21 5 3z"/></svg>
										<span class="pr-merge-label">Merge pull request</span>
									</button>
									<span class="pr-merge-note"></span>
								</div>
							</div>

						</div>

						<!-- Shutter flash -->
						<div class="tl-capture-flash" id="tl-capture-flash"></div>
					</div>

					<!-- Timeline scrubber -->
					<div class="tl-timeline">
						<div class="tl-track">
							<div class="tl-track-line"></div>
							<!-- Version markers -->
							<button class="tl-marker active" data-version="0" id="tl-v0">
								<div class="tl-marker-dot"></div>
								<div class="tl-marker-label">v1<br/><span>Jul 3 · 9 AM</span></div>
							</button>
							<button class="tl-marker" data-version="1" id="tl-v1">
								<div class="tl-marker-dot"></div>
								<div class="tl-marker-label">v2<br/><span>Jul 3 · 2 PM</span></div>
							</button>
							<button class="tl-marker" data-version="2" id="tl-v2">
								<div class="tl-marker-dot"></div>
								<div class="tl-marker-label">v3<br/><span>Jul 4 · 11 AM</span></div>
							</button>
							<button class="tl-marker" data-version="3" id="tl-v3">
								<div class="tl-marker-dot"></div>
								<div class="tl-marker-label">v4<br/><span>Jul 4 · 3 PM</span></div>
							</button>
						</div>
					</div>
				</div>

					<!-- Actionable OCR & Macro Simulator (Interactive) -->
					<div class="glass-card feature-card feature-card-large" id="ocr-target-section">
						<div class="feature-info-row">
							<div>
								<div class="feature-icon-wrapper purple-glow">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#bf5af2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<polyline points="4 7 4 4 20 4 20 7"/>
										<line x1="9" y1="20" x2="15" y2="20"/>
										<line x1="12" y1="4" x2="12" y2="20"/>
									</svg>
								</div>
								<h3>4. Extract & Automate (Actionable OCR)</h3>
								<p>Extracting text is just the beginning. Aeroshot detects data syntax (JSON structures, hex colors, error stack traces) and instantly provides contextual macros to format, debug, or copy parsed code blocks.</p>
							</div>
						</div>

						<!-- OCR Macro Sandbox -->
						<div class="ocr-sandbox">
							<div class="ocr-source-area" id="ocr-source" style="padding: 16px;">
								<div class="ocr-target-image" id="ocr-source-image-wrap" style="background: #08090a; text-align: left; font-family: monospace; font-size: 0.8rem; overflow: hidden; height: 100%; display: flex; flex-direction: column; justify-content: center; gap: 8px;">
									<div class="terminal-header-mock">Terminal — build_errors.log</div>
									<div class="terminal-text-block">
										<span class="term-err-red">[Error] Build compilation failed.</span><br/>
										<span class="term-dim">Code syntax:</span> <span class="term-green" id="ocr-source-hex">#0a84ff</span><br/>
										<span class="term-dim">Payload:</span> <span class="term-yellow" id="ocr-source-json">&#123;"status":"error","code":500,"msg":"database connection offset timeout"&#125;</span>
									</div>
								</div>
								<div class="ocr-crop-overlay" id="ocr-overlay"></div>
							</div>
							
							<div class="ocr-result-arrow" id="ocr-flow-arrow">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<line x1="5" y1="12" x2="19" y2="12"/>
									<polyline points="12 5 19 12 12 19"/>
								</svg>
							</div>
							
							<div class="ocr-destination-clipboard">
								<div class="clipboard-header">
									<span>OCR Intent Inspector</span>
									<span class="clipboard-status" id="ocr-status">Ready</span>
								</div>
								<div class="clipboard-content" style="flex-direction: column; gap: 12px; align-items: stretch; justify-content: flex-start; padding: 14px;">
									<div class="clipboard-text-box" style="flex: 1; width: 100%; border: 1px solid var(--card-border); background: #050607; padding: 10px; border-radius: 4px; font-family: monospace; font-size: 0.8rem; min-height: 80px; overflow-y: auto;">
										<code id="ocr-output-text">// Click "Scan & Run Macros" to process...</code>
									</div>
									
									<!-- Contextual Macro Actions HUD (Appears when scanned) -->
									<div class="ocr-macros-hud" id="ocr-macros-hud">
										<button class="macro-hud-btn" id="macro-btn-json">
											<span>🔧 Format JSON</span>
										</button>
										<button class="macro-hud-btn" id="macro-btn-color">
											<span>🎨 Copy Swift Color</span>
										</button>
										<button class="macro-hud-btn" id="macro-btn-debug">
											<span>🔍 Debug Error</span>
										</button>
									</div>
									<button class="btn btn-secondary btn-sm" id="btn-run-ocr-macros" style="width: 100%;">⚡ Scan & Run Macros</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 3D Anatomy Section -->
		<section id="anatomy" class="anatomy-section glow-effect">
			<div class="container anatomy-container">
				<div class="anatomy-info">
					<div class="badge">Advanced Engine</div>
					<h2>Anatomy of a Capture</h2>
					<p class="anatomy-desc">
						Aeroshot doesn't just copy pixels. It processes captures through five independent layers in milliseconds to create rich, high-fidelity mockups.
					</p>
					
					<!-- Range slider control -->
					<div class="explode-control-wrapper">
						<div class="slider-labels">
							<span>Compact View</span>
							<span class="active-val" id="explode-val">50px Depth</span>
							<span>Exploded Stack</span>
						</div>
						<input type="range" id="explode-slider" min="10" max="150" value="50" class="explode-slider" aria-label="Explode 3D Stack Depth" />
					</div>

					<!-- Layer guide indicators -->
					<div class="layer-indicators">
						<div class="indicator-item" data-layer="4">
							<span class="color-dot hud"></span>
							<div class="ind-text">
								<strong>Layer 5: Toolbar HUD</strong>
								<span>Floating quick-action controls</span>
							</div>
