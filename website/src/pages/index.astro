		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: rgba(30, 30, 35, 0.95);
		border: 1px solid var(--card-border);
		color: var(--text-secondary);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 16px;
		cursor: pointer;
		z-index: 10;
		box-shadow: 0 3px 6px rgba(0, 0, 0, 0.4);
		line-height: 1;
	}

	.thumbnail-close-btn:hover {
		color: white;
		background: #ff5f56;
		border-color: #ff5f56;
	}

	.thumbnail-preview-img {
		flex: 1;
		border-radius: 12px;
		overflow: hidden;
		background: #111215;
		position: relative;
		border: 1px solid rgba(255, 255, 255, 0.05);
	}

	.mini-preview-gradient {
		position: absolute;
		inset: 4px;
		border-radius: 8px;
		background: linear-gradient(135deg, #152238 0%, #08090a 100%);
	}

	.mini-preview-lines {
		position: absolute;
		inset: 16px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.mini-preview-lines span {
		height: 4px;
		background: rgba(255, 255, 255, 0.1);
		border-radius: 2px;
		width: 100%;
	}

	.mini-preview-lines span:last-child {
		width: 60%;
	}

	/* Actions overlay on hover */
	.thumbnail-actions-overlay {
		position: absolute;
		inset: 6px;
		border-radius: 12px;
		background: rgba(8, 9, 10, 0.85);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		opacity: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 6px;
		padding: 10px;
		transition: opacity 0.25s ease;
		pointer-events: none;
		z-index: 5;
	}

	.floating-thumbnail:hover .thumbnail-actions-overlay {
		opacity: 1;
		pointer-events: auto;
	}

	.thumb-act-btn {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--card-border);
		border-radius: 6px;
		color: var(--text-primary);
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 600;
		padding: 6px;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 4px;
		transition: var(--transition-smooth);
	}

	.thumb-act-btn:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: white;
	}

	.thumbnail-copied-toast {
		position: absolute;
		inset: 6px;
		border-radius: 12px;
		background: rgba(48, 209, 88, 0.95);
		color: white;
		font-size: 0.75rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
		z-index: 6;
	}

	.thumbnail-copied-toast.active {
		opacity: 1;
	}

	/* Beautify & Annotation Modal */
	.beautify-modal-overlay {
		position: fixed;
		inset: 0;
		background: rgba(8, 9, 10, 0.75);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		z-index: 10000;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 24px;
	}

	.beautify-modal-overlay.active {
		display: flex;
	}

	.beautify-modal-card {
		width: 100%;
		max-width: 980px;
		background: rgba(18, 20, 24, 0.96);
		border-radius: var(--radius-lg);
		box-shadow: 0 30px 75px rgba(0, 0, 0, 0.65);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		border: 1px solid var(--card-border);
	}

	.modal-header {
		padding: 14px 20px;
		border-bottom: 1px solid var(--card-border);
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: rgba(255, 255, 255, 0.02);
		position: relative;
	}

	.modal-window-title {
		font-size: 0.8rem;
		color: var(--text-secondary);
		font-weight: 500;
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		font-family: monospace;
	}

	.modal-content-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		height: 580px;
	}

	.modal-preview-pane {
		background: #090a0c;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
		overflow: hidden;
		border-right: 1px solid var(--card-border);
		position: relative;
	}

	.modal-beautify-canvas {
		width: 100%;
		max-height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 8px;
		transition: padding 0.2s ease, background 0.2s ease;
		overflow: hidden;
	}

	.modal-beautify-img-wrapper {
		position: relative;
		display: inline-block;
		max-width: 100%;
		box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5);
		border-radius: 4px;
		overflow: hidden;
	}

	.modal-beautify-img-wrapper img {
		display: block;
		max-width: 100%;
		height: auto;
		user-select: none;
		-webkit-user-drag: none;
	}

	/* Drawing Canvas layered directly over the screenshot */
	#annotation-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 5;
		cursor: crosshair;
	}

	/* Floating macOS-Style Annotation HUD */
	.modal-hud-toolbar {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: rgba(22, 24, 28, 0.85);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
		border-radius: 99px;
		display: flex;
		align-items: center;
		padding: 6px 14px;
		gap: 6px;
		z-index: 100;
	}

	.hud-btn, .hud-btn-action {
		background: none;
		border: none;
		color: var(--text-secondary);
		width: 32px;
		height: 32px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: default;
		transition: var(--transition-smooth);
		padding: 0;
		outline: none;
	}

	.hud-btn:hover, .hud-btn-action:hover {
		background: rgba(255, 255, 255, 0.06);
		color: white;
	}

	.hud-btn.active {
		background: var(--accent);
		color: white;
	}

	.hud-btn-action.clear:hover {
		background: rgba(255, 69, 58, 0.15);
		color: #ff453a;
	}

	.hud-divider {
		width: 1px;
		height: 18px;
		background: rgba(255, 255, 255, 0.12);
		margin: 0 6px;
	}

	.hud-color-pickers {
		display: flex;
		gap: 6px;
		align-items: center;
	}

	.hud-color-dot {
		width: 16px;
		height: 16px;
		border-radius: 50%;
		border: 1.5px solid transparent;
		cursor: default;
		transition: var(--transition-smooth);
		padding: 0;
		outline: none;
	}

	.hud-color-dot.active {
		border-color: white;
		transform: scale(1.15);
	}

	/* macOS Inspector Style Settings Pane */
	.modal-controls-pane {
		padding: 24px;
		display: flex;
		flex-direction: column;
		gap: 18px;
		overflow-y: auto;
		background: rgba(22, 24, 28, 0.4);
	}

	.inspector-section-title {
		font-family: var(--font-display);
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-secondary);
		margin-bottom: 2px;
	}

	.inspector-section-divider {
		height: 1px;
		background: var(--card-border);
		margin: 8px 0;
	}

	.control-group {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.control-group label {
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--text-tertiary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	/* Color pickers fallback overrides */
	.gradient-pickers {
		display: flex;
		gap: 8px;
	}

	.gradient-dot {
		width: 26px;
		height: 26px;
		border-radius: 50%;
		border: 2px solid transparent;
		cursor: default;
		transition: var(--transition-smooth);
	}

	.gradient-dot.active {
		border-color: white;
		transform: scale(1.1);
	}

	.toggle-switch-wrapper {
		display: flex;
		align-items: center;
		color: var(--text-secondary);
		font-size: 0.85rem;
	}

	/* Inline OCR Panel */
	.ocr-status-inline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 4px;
	}

	.ocr-inline-status {
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--text-tertiary);
		font-family: monospace;
	}

	.ocr-inline-status.active {
		color: var(--accent-2);
	}

	.ocr-inline-textarea-wrapper {
		position: relative;
		border: 1px solid var(--card-border);
		border-radius: 6px;
		overflow: hidden;
		background: #08090a;
	}

	.ocr-inline-textarea-wrapper textarea {
		width: 100%;
		height: 85px;
		background: transparent;
		border: none;
		color: var(--text-primary);
		padding: 10px;
		font-family: monospace;
		font-size: 0.8rem;
		resize: none;
		outline: none;
	}

	.btn-xs-copy {
		position: absolute;
		bottom: 6px;
		right: 6px;
		padding: 4px 8px;
		font-size: 0.7rem;
		background: rgba(255, 255, 255, 0.05);
		border-color: var(--card-border);
	}

	.btn-full {
		width: 100%;
		padding: 12px;
	}

	/* Features Section */
	.features-section {
		padding: 100px 0;
	}

	.section-header {
		text-align: center;
		margin-bottom: 60px;
	}

	.section-title {
		margin-bottom: 16px;
	}

	.section-subtitle {
		max-width: 600px;
		margin: 0 auto;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 30px;
	}

	.feature-card {
		padding: 40px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 380px;
	}

	.feature-card-large {
		grid-column: span 2;
		min-height: 480px;
	}

	.feature-icon-wrapper {
		width: 48px;
		height: 48px;
		border-radius: var(--radius-md);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 24px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--card-border);
	}

	.feature-card h3 {
		margin-bottom: 12px;
	}

	.feature-card p {
		margin-bottom: 30px;
		font-size: 1rem;
		line-height: 1.6;
	}

	.feature-preview {
		background: rgba(0, 0, 0, 0.4);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-md);
		height: 160px;
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	/* Red & Green Glows */
	.red-glow { background: rgba(255, 69, 58, 0.08); border-color: rgba(255, 69, 58, 0.2); }
	.green-glow { background: rgba(48, 209, 88, 0.08); border-color: rgba(48, 209, 88, 0.2); }
	.blue-glow { background: rgba(10, 132, 255, 0.08); border-color: rgba(10, 132, 255, 0.2); }
	.purple-glow { background: rgba(191, 90, 242, 0.08); border-color: rgba(191, 90, 242, 0.2); }

	/* Prove feature detail styles */
	.filename-tag {
		position: absolute;
		top: 12px;
		left: 12px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid var(--card-border);
		border-radius: 4px;
		padding: 4px 10px;
		font-size: 0.75rem;
	}

	.annotation-mock {
		position: relative;
		width: 80%;
		height: 60%;
		border: 1px dashed rgba(255, 69, 58, 0.4);
		border-radius: 6px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.bug-tag {
		background: #ff453a;
		color: white;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 4px 8px;
		border-radius: 4px;
		margin-right: 10px;
	}

	.arrow-svg {
		color: #ff453a;
	}

	/* Teach feature detail styles */
	.timeline-preview {
		background: #0b0c0e;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.recording-badge-mock {
		position: absolute;
		top: 12px;
		left: 12px;
		background: rgba(255, 69, 58, 0.15);
		border: 1px solid rgba(255, 69, 58, 0.3);
		color: #ff453a;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 4px 10px;
		border-radius: 4px;
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.rec-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #ff453a;
		display: inline-block;
		animation: pulseRed 1s infinite alternate;
	}

	@keyframes pulseRed {
		from { opacity: 0.3; }
		to { opacity: 1; }
	}

	.cursor-mock {
		position: relative;
		color: white;
		transform: translate(20px, 20px);
	}

	.click-ripple {
		position: absolute;
		top: -12px;
		left: -12px;
		width: 32px;
		height: 32px;
		border: 2px solid #30d158;
		border-radius: 50%;
		opacity: 0;
		transform: scale(0.2);
		animation: rippleEffect 2s infinite ease-out;
	}

	@keyframes rippleEffect {
		0% { transform: scale(0.2); opacity: 0.8; }
		80% { transform: scale(1.2); opacity: 0; }
		100% { opacity: 0; }
	}

	/* Large Feature Layouts */
	.feature-info-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 40px;
		margin-bottom: 24px;
	}

	.feature-info-row > div {
		max-width: 60%;
	}

	.demo-controls {
		margin-top: 10px;
	}

	/* Beautify Sandbox */
	.beautify-sandbox {
		background: #050607;
		border: 1px solid var(--card-border);
		border-radius: var(--radius-md);
		height: 260px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		position: relative;
	}

	.beautify-backdrop {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: var(--transition-smooth);
		padding: 0;
		background: transparent;
	}

	/* Active Beautify Mode styles */
	.beautify-backdrop.beautified {
		background: linear-gradient(135deg, #152238 0%, #1c3150 100%);
		padding: 36px;
	}

	.beautify-window {
		width: 90%;
		max-width: 440px;
		background: #1e1e1e;
		border: 1px solid #333333;
		border-radius: 4px;
		transition: var(--transition-smooth);
		box-shadow: none;
	}

	.beautified .beautify-window {
		border-radius: 12px;
		border-color: rgba(255, 255, 255, 0.15);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 1px rgba(255, 255, 255, 0.3);
	}

	.window-body-content {
		padding: 20px;
		font-family: monospace;
		font-size: 0.85rem;
	}

	.window-text-highlight {
		color: var(--text-secondary);
		margin-bottom: 12px;
		font-size: 0.75rem;
	}

	.code-line {
		display: block;
		margin-bottom: 6px;
	}

	.green-text {
		color: #30d158;
	}

	/* OCR Sandbox styling */
	.ocr-sandbox {
		display: flex;
		align-items: center;
		gap: 20px;
		height: 260px;
	}

	.ocr-source-area {
		flex: 1;
		background: #111215;
		border: 1px solid var(--card-border);
		border-radius: var(--radius-md);
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		position: relative;
		overflow: hidden;
		text-align: center;
		padding: 24px;
	}

	.ocr-target-image {
		width: 100%;
		border: 1px solid rgba(255, 255, 255, 0.05);
		border-radius: 6px;
		padding: 20px;
		background: #08090a;
	}

	.ocr-target-image img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.embedded-text {
		font-size: 0.9rem;
		font-style: italic;
		color: var(--text-primary);
		margin-bottom: 6px;
	}

	.author-text {
		font-size: 0.75rem;
		color: var(--text-secondary);
	}

	.ocr-crop-overlay {
		position: absolute;
		border: 1.5px solid var(--accent-2);
		background: rgba(100, 210, 255, 0.08);
		top: 15%;
		left: 10%;
		width: 80%;
		height: 70%;
		display: none;
		border-radius: 4px;
		box-shadow: 0 0 15px rgba(100, 210, 255, 0.2);
	}

	.ocr-crop-overlay.scanning {
		display: block;
		animation: scanningEffect 2s infinite linear;
	}

	@keyframes scanningEffect {
		0% { box-shadow: 0 -2px 10px rgba(100, 210, 255, 0.1); }
		50% { box-shadow: 0 2px 15px rgba(100, 210, 255, 0.3); }
		100% { box-shadow: 0 -2px 10px rgba(100, 210, 255, 0.1); }
	}

	.ocr-result-arrow {
		color: var(--text-tertiary);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.ocr-result-arrow.active {
		color: var(--accent-2);
		animation: pulseArrow 1s infinite alternate;
	}

	@keyframes pulseArrow {
		from { transform: translateX(0); }
		to { transform: translateX(4px); }
	}

	.ocr-destination-clipboard {
		flex: 1;
		background: #111215;
		border: 1px solid var(--card-border);
		border-radius: var(--radius-md);
		height: 100%;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.clipboard-header {
		padding: 12px 16px;
		background: rgba(255, 255, 255, 0.02);
		border-bottom: 1px solid var(--card-border);
		display: flex;
		justify-content: space-between;
		font-size: 0.75rem;
		font-weight: 600;
	}

	.clipboard-status {
		color: var(--text-tertiary);
	}

	.clipboard-status.active {
		color: var(--accent-2);
	}

	.clipboard-content {
		padding: 20px;
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: monospace;
		font-size: 0.85rem;
		color: var(--text-secondary);
		background: #08090a;
	}

	.ocr-copied-highlight {
		color: var(--text-primary);
		animation: textType 0.5s ease-out forwards;
	}

	/* 3D Anatomy Section */
	.anatomy-section {
		padding: 120px 0;
		border-top: 1px solid var(--card-border);
		background: radial-gradient(circle at 80% 50%, #0e1b2f 0%, #08090a 50%);
	}

	.anatomy-container {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 60px;
		align-items: center;
	}

	.anatomy-desc {
		font-size: 1.15rem;
		margin-bottom: 40px;
		max-width: 500px;
	}

	.explode-control-wrapper {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-md);
		padding: 20px 24px;
		margin-bottom: 40px;
	}

	.slider-labels {
		display: flex;
		justify-content: space-between;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--text-secondary);
		margin-bottom: 12px;
	}

	.active-val {
		color: var(--accent-2);
		background: rgba(100, 210, 255, 0.1);
		padding: 2px 8px;
		border-radius: 4px;
	}

	.explode-slider {
		-webkit-appearance: none;
		width: 100%;
		height: 6px;
		border-radius: 3px;
		background: rgba(255, 255, 255, 0.1);
		outline: none;
	}

	.explode-slider::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: var(--accent-2);
		border: 2px solid white;
		cursor: pointer;
		box-shadow: 0 0 10px rgba(100, 210, 255, 0.5);
		transition: var(--transition-smooth);
	}

