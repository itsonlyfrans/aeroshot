<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary>
    <suite name="ScreenCapture Scripting" code="ScCp" description="Commands for ScreenCapture">
        <command name="capture area" code="ScCpCrAr" description="Capture a selected screen region.">
            <cocoa class="ScreenCaptureScripting" method="captureArea:"/>
        </command>
        <command name="capture window" code="ScCpCrWi" description="Capture the window under the cursor.">
            <cocoa class="ScreenCaptureScripting" method="captureWindow:"/>
        </command>
        <command name="capture screen" code="ScCpCrSc" description="Capture the full screen.">
            <cocoa class="ScreenCaptureScripting" method="captureScreen:"/>
        </command>
        <command name="capture last region" code="ScCpCrLR" description="Capture the previous area selection.">
            <cocoa class="ScreenCaptureScripting" method="captureLastRegion:"/>
        </command>
        <command name="open all in one" code="ScCpOpAO" description="Open the All-in-One capture HUD.">
            <cocoa class="ScreenCaptureScripting" method="openAllInOne:"/>
        </command>
        <command name="open history" code="ScCpOpHi" description="Open capture history.">
            <cocoa class="ScreenCaptureScripting" method="openHistory:"/>
        </command>
    </suite>
</dictionary>
